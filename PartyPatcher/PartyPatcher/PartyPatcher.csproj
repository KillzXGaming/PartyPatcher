<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="VGAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\external\ImageLibrary\src\ImageLibrary.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="AvaloniaToolbox.Core">
      <HintPath>..\external\AvaloniaToolbox.Core.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="mods\SampleSpriteMP4\" />
    <Folder Include="mods\SampleMessageMP4\" />
  </ItemGroup>

  <ItemGroup>
    <None Update="mods\SampleSpriteMP4\Patch.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="mods\SampleSpriteMP4\Sheet.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="mods\SampleSpriteMP4\Texture0.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="mods\SampleSpriteMP4\Toad.hsf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
